{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "Override": {
      "Microsoft.AspNetCore": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderDatabase": "Host=localhost;Port=5437;Database=OrderDb;Username=postgres;Password=postgres"
  },
  "JWTSettings": {
    "jwksUrl": "http://localhost:7119/.well-known/jwks.json"
  },
  "RabbitMQ": {
    "Hostname": "localhost",
    "Port": 5672,
    "RetryDelay": "00:05:00",
    "Username": "guest",
    "Password": "guest",
    "EnableTls": false,
    "Queue": "Product"
  }
}
